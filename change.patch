@@ -0,0 +1,139 @@
+import { execFileSync } from "node:child_process";
+import { mkdirSync, mkdtempSync, readFileSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { dirname, join } from "node:path";
+import { describe, expect, it } from "vitest";
+import { assertAgentPath, AgentOutputError } from "../phase5/code-parse";
+import { assertSafePath } from "../phase5/pr";
+import { bootstrapBody, bootstrapBranch } from "./bootstrap";
+import { missingFiles, templateFiles } from "./template";
+
+function site(files: Record<string, string>): string {
+  const dir = mkdtempSync(join(tmpdir(), "site-"));
+  for (const t of templateFiles("demo-landing")) {
+    if (t.path.startsWith(".github/")) continue;
+    mkdirSync(dirname(join(dir, t.path)), { recursive: true });
+    writeFileSync(join(dir, t.path), t.content);
+  }
+  for (const [p, c] of Object.entries(files)) {
+    mkdirSync(dirname(join(dir, p)), { recursive: true });
+    writeFileSync(join(dir, p), c);
+  }
+  return dir;
+}
+
+function run(dir: string, cmd: "build" | "check"): { code: number; out: string } {
+  try {
+    const out = execFileSync("node", ["scripts/site.mjs", cmd], { cwd: dir, encoding: "utf8", stdio: "pipe" });
+    return { code: 0, out };
+  } catch (e) {
+    const err = e as { status?: number; stderr?: string; stdout?: string };
+    return { code: err.status ?? 1, out: `${err.stdout ?? ""}${err.stderr ?? ""}` };
+  }
+}
+
+describe("templateFiles", () => {
+  const files = templateFiles("demo-landing");
+  const get = (p: string) => files.find((f) => f.path === p)?.content ?? "";
+
+  it("berisi 4 file tetap", () => {
+    expect(files.map((f) => f.path)).toEqual([
+      ".github/workflows/ci.yml",
+      "package.json",
+      "wrangler.jsonc",
+      "scripts/site.mjs",
+    ]);
+  });
+
+  it("ci.yml punya job bernama test, izin read-only, tanpa secret", () => {
+    const ci = get(".github/workflows/ci.yml");
+    expect(ci).toContain("  test:\n    name: test");
+    expect(ci).toContain("contents: read");
+    expect(ci).toContain("pull_request:");
+    expect(ci).not.toContain("secrets.");
+  });
+
+  it("package.json valid, tanpa dependensi", () => {
+    const pkg = JSON.parse(get("package.json")) as Record<string, unknown>;
+    expect(pkg.name).toBe("demo-landing");
+    expect(pkg.dependencies).toBeUndefined();
+    expect(pkg.devDependencies).toBeUndefined();
+  });
+
+  it("wrangler.jsonc memakai nama worker dan aset dist", () => {
+    expect(get("wrangler.jsonc")).toContain('"name": "demo-landing"');
+    expect(get("wrangler.jsonc")).toContain('"directory": "dist"');
+  });
+
+  it("menolak nama worker tidak valid", () => {
+    expect(() => templateFiles("../x")).toThrow();
+    expect(() => templateFiles("Besar")).toThrow();
+  });
+
+  it("missingFiles tidak menimpa file yang sudah ada", () => {
+    const m = missingFiles(files, new Set(["package.json"]));
+    expect(m.map((f) => f.path)).not.toContain("package.json");
+    expect(m).toHaveLength(3);
+  });
+});
+
+describe("skrip site.mjs (dijalankan sungguhan)", () => {
+  it("build + check lulus untuk halaman valid", () => {
+    const dir = site({ "index.html": '<a href="#menu">m</a><link href="css/s.css"><a href="/about/">a</a>', "css/s.css": "a{}", "about/index.html": "<p>x</p>" });
+    expect(run(dir, "build").code).toBe(0);
+    const r = run(dir, "check");
+    expect(r.code, r.out).toBe(0);
+    expect(readFileSync(join(dir, "dist/css/s.css"), "utf8")).toBe("a{}");
+  });
+
+  it("check gagal bila rujukan file hilang", () => {
+    const dir = site({ "index.html": '<script src="app.js"></script>' });
+    run(dir, "build");
+    const r = run(dir, "check");
+    expect(r.code).toBe(1);
+    expect(r.out).toContain("app.js");
+  });
+
+  it("check gagal bila index.html tidak ada", () => {
+    const dir = site({ "lain.html": "<p>x</p>" });
+    run(dir, "build");
+    expect(run(dir, "check").code).toBe(1);
+  });
+
+  it("file template tidak ikut ke dist", () => {
+    const dir = site({ "index.html": "<p>x</p>" });
+    run(dir, "build");
+    const r = run(dir, "check");
+    expect(r.code).toBe(0);
+    expect(() => readFileSync(join(dir, "dist/package.json"))).toThrow();
+    expect(() => readFileSync(join(dir, "dist/scripts/site.mjs"))).toThrow();
+  });
+});
+
+describe("izin workflow", () => {
+  it("assertSafePath: hanya ci.yml dan hanya dengan flag", () => {
+    expect(() => assertSafePath(".github/workflows/ci.yml")).toThrow();
+    expect(() => assertSafePath(".github/workflows/ci.yml", true)).not.toThrow();
+    expect(() => assertSafePath(".github/workflows/evil.yml", true)).toThrow();
+  });
+
+  it("agent AI tetap tidak boleh menyentuh .github atau berkas template", () => {
+    for (const p of [".github/workflows/ci.yml", "package.json", "wrangler.jsonc"]) {
+      expect(() => assertAgentPath(p, "external"), p).toThrow(AgentOutputError);
+    }
+  });
+});
+
+describe("bootstrap helpers", () => {
+  it("branch lolos aturan agent/*", () => {
+    const b = bootstrapBranch(Date.UTC(2026, 9, 22, 3, 4, 5));
+    expect(b).toBe("agent/bootstrap-20261022t030405z");
+    expect(/^agent\/[a-z0-9][a-z0-9._-]{0,80}$/.test(b)).toBe(true);
+  });
+
+  it("body PR memuat file dan langkah ruleset", () => {
+    const body = bootstrapBody("demo-landing", "o/demo-landing", ["package.json"]);
+    expect(body).toContain("`package.json`");
+    expect(body).toContain("protect-main");
+  });
+});
diff --git a/apps/api/src/phase7/template.ts b/apps/api/src/phase7/template.ts
new file mode 100644
index 0000000..51d287d
--- /dev/null
+++ b/apps/api/src/phase7/template.ts
@@ -0,0 +1,147 @@
+// Fase 7c: template CI proyek baru. Isi TETAP (bukan buatan AI) supaya aman ditulis ke .github/workflows.
+// Proyek target = situs statis: build menyalin file situs ke dist/, tes memeriksa dist/ + rujukan file.
+
+export interface TemplateFile {
+  path: string;
+  content: string;
+}
+
+export const WORKER_NAME_RE = /^[a-z0-9][a-z0-9-]{0,62}$/;
+
+const CI_YML = [
+  "name: CI",
+  "",
+  "on:",
+  "  pull_request:",
+  "    branches: [main]",
+  "  workflow_dispatch:",
+  "",
+  "permissions:",
+  "  contents: read",
+  "",
+  "concurrency:",
+  "  group: ci-${{ github.ref }}",
+  "  cancel-in-progress: true",
+  "",
+  "jobs:",
+  "  test:",
+  "    name: test",
+  "    runs-on: ubuntu-latest",
+  "    timeout-minutes: 5",
+  "    steps:",
+  "      - uses: actions/checkout@v4",
+  "      - uses: actions/setup-node@v4",
+  "        with:",
+  "          node-version: 22",
+  "      - run: npm run build",
+  "      - run: npm test",
+  "",
+].join("\n");
+
+// Tanpa backtick dan tanpa pemisah templat: skrip ini ditulis apa adanya ke repo target.
+const SITE_MJS = String.raw`// Build + tes situs statis. Tanpa dependensi.
+// node scripts/site.mjs build  -> salin file situs ke dist/
+// node scripts/site.mjs check  -> pastikan dist/index.html ada dan semua rujukan lokal ada
+import { copyFileSync, existsSync, mkdirSync, readdirSync, readFileSync, rmSync, statSync } from "node:fs";
+import { dirname, extname, join, posix } from "node:path";
+
+const SKIP_DIRS = new Set(["dist", "scripts", "node_modules"]);
+const SKIP_FILES = new Set(["package.json", "package-lock.json", "wrangler.jsonc", "README.md"]);
+
+function walk(dir, rel, out) {
+  for (const e of readdirSync(dir, { withFileTypes: true })) {
+    if (e.name.startsWith(".")) continue;
+    const r = rel ? rel + "/" + e.name : e.name;
+    if (e.isDirectory()) {
+      if (!SKIP_DIRS.has(e.name)) walk(join(dir, e.name), r, out);
+    } else if (!(rel === "" && SKIP_FILES.has(e.name))) {
+      out.push(r);
+    }
+  }
+  return out;
+}
+
+function build() {
+  rmSync("dist", { recursive: true, force: true });
+  const files = walk(".", "", []);
+  for (const f of files) {
+    mkdirSync(dirname(join("dist", f)), { recursive: true });
+    copyFileSync(f, join("dist", f));
+  }
+  console.log("build: " + files.length + " file -> dist/");
+}
+
+function refsOf(html) {
+  const refs = [];
+  const re = /\b(?:src|href)\s*=\s*["']([^"']+)["']/gi;
+  let m;
+  while ((m = re.exec(html)) !== null) refs.push(m[1].trim());
+  return refs;
+}
+
+function check() {
+  const errors = [];
+  if (!existsSync("dist/index.html") || statSync("dist/index.html").size === 0) {
+    errors.push("dist/index.html tidak ada atau kosong");
+  }
+  const pages = existsSync("dist") ? walk("dist", "", []).filter((f) => extname(f).toLowerCase() === ".html") : [];
+  for (const page of pages) {
+    const base = posix.dirname(page);
+    for (const ref of refsOf(readFileSync(join("dist", page), "utf8"))) {
+      if (!ref || /^(https?:|\/\/|mailto:|tel:|data:|javascript:|#)/i.test(ref)) continue;
+      const clean = ref.split(/[?#]/)[0];
+      if (!clean) continue;
+      let target = clean.startsWith("/") ? posix.normalize(clean.slice(1)) : posix.normalize(posix.join(base, clean));
+      if (target === "." || target.endsWith("/")) target = posix.join(target, "index.html");
+      if (!existsSync(join("dist", target))) errors.push(page + " merujuk " + ref + " yang tidak ada");
+    }
+  }
+  if (errors.length) {
+    for (const e of errors) console.error("GAGAL: " + e);
+    process.exit(1);
+  }
+  console.log("check: OK (" + pages.length + " halaman HTML)");
+}
+
+const cmd = process.argv[2];
+if (cmd === "build") build();
+else if (cmd === "check") check();
+else {
+  console.error("pakai: node scripts/site.mjs build|check");
+  process.exit(2);
+}
+`;
+
+export function templateFiles(workerName: string): TemplateFile[] {
+  if (!WORKER_NAME_RE.test(workerName)) throw new Error(`nama worker tidak valid: ${workerName}`);
+  const pkg = {
+    name: workerName,
+    private: true,
+    version: "0.1.0",
+    type: "module",
+    scripts: {
+      build: "node scripts/site.mjs build",
+      test: "node scripts/site.mjs build && node scripts/site.mjs check",
+    },
+  };
+  const wrangler = [
+    "{",
+    '  "$schema": "node_modules/wrangler/config-schema.json",',
+    `  "name": "${workerName}",`,
+    '  "compatibility_date": "2025-10-01",',
+    '  "assets": { "directory": "dist" }',
+    "}",
+    "",
+  ].join("\n");
+  return [
+    { path: ".github/workflows/ci.yml", content: CI_YML },
+    { path: "package.json", content: `${JSON.stringify(pkg, null, 2)}\n` },
+    { path: "wrangler.jsonc", content: wrangler },
+    { path: "scripts/site.mjs", content: SITE_MJS },
+  ];
+}
+
+/** Hanya file yang belum ada di main yang dibuat; file yang sudah ada tidak pernah ditimpa. */
+export function missingFiles(files: readonly TemplateFile[], existing: ReadonlySet<string>): TemplateFile[] {
+  return files.filter((f) => !existing.has(f.path));
+}
