@@ -0,0 +1,376 @@
+// API alur multi-agent Fase 3. Pasang SETELAH middleware auth pemilik:
+//   app.route("/api/runs", runRoutes);
+
+import { PIPELINE_TEMPLATES, type RunStatus } from "@avo/shared";
+import { Hono } from "hono";
+import { z } from "zod";
+import { checkBudget, getTemplate, readLimits, validateSteps } from "./pipeline";
+import { runEventStmt, type Phase3Env } from "./shared";
+import { loadDayUsage } from "./workflow";
+
+const MAX_ATTEMPTS = 5;
+const ACTIVE: RunStatus[] = ["queued", "running", "awaiting_approval", "pausing", "paused"];
+
+interface RunRow {
+  id: string;
+  title: string;
+  goal: string;
+  template: string;
+  status: RunStatus;
+  attempts: number;
+  instance_id: string | null;
+  current_step: number | null;
+  error: string | null;
+  created_at: number;
+  updated_at: number;
+}
+
+interface ListRow extends Omit<RunRow, "goal"> {
+  steps_total: number;
+  steps_done: number;
+  total_tokens: number | null;
+}
+
+interface StepDbRow {
+  idx: number;
+  agent: string;
+  title: string;
+  depends_on: string;
+  needs_approval: number;
+  status: string;
+  output: string | null;
+  approval_note: string | null;
+  provider: string | null;
+  model: string | null;
+  prompt_tokens: number | null;
+  completion_tokens: number | null;
+  total_tokens: number | null;
+  latency_ms: number | null;
+  error: string | null;
+}
+
+export const runRoutes = new Hono<{ Bindings: Phase3Env }>();
+
+const createSchema = z.object({
+  goal: z.string().trim().min(10).max(4000),
+  template: z.string().trim().min(1).max(40),
+  title: z.string().trim().max(80).optional(),
+});
+
+const noteSchema = z.object({ note: z.string().trim().max(500).optional() }).default({});
+
+function mapInstance(s: string): RunStatus | null {
+  switch (s) {
+    case "queued":
+      return "queued";
+    case "running":
+    case "waiting":
+      return "running";
+    case "waitingForPause":
+      return "pausing";
+    case "paused":
+      return "paused";
+    case "errored":
+    case "terminated":
+      return "failed";
+    default:
+      return null; // complete / unknown: Workflow yang menulis hasil akhir ke D1
+  }
+}
+
+// Samakan status D1 dengan instance Workflow. 'awaiting_approval' di D1 adalah keadaan yang
+// lebih spesifik daripada 'waiting' milik Workflow, jadi tidak boleh ditimpa 'running'.
+async function syncStatus<
+  T extends { id: string; status: RunStatus; instance_id: string | null; error: string | null },
+>(env: Phase3Env, run: T): Promise<T> {
+  if (!ACTIVE.includes(run.status) || !run.instance_id) return run;
+  try {
+    const inst = await env.RUN_WORKFLOW.get(run.instance_id);
+    const s = await inst.status();
+    const mapped = mapInstance(s.status);
+    if (!mapped || mapped === run.status) return run;
+    if (run.status === "awaiting_approval" && mapped === "running") return run;
+    const rawErr = s.error as unknown;
+    const err =
+      mapped === "failed"
+        ? typeof rawErr === "string"
+          ? rawErr
+          : ((rawErr as { message?: string } | undefined)?.message ?? `Workflow ${s.status}`)
+        : null;
+    const res = await env.DB.prepare(
+      "UPDATE p3_runs SET status = ?, error = COALESCE(?, error), updated_at = ? WHERE id = ? AND status = ?",
+    )
+      .bind(mapped, err, Date.now(), run.id, run.status)
+      .run();
+    if (!res.meta.changes) return run;
+    return { ...run, status: mapped, error: err ?? run.error };
+  } catch {
+    return run;
+  }
+}
+
+function getRun(env: Phase3Env, id: string) {
+  return env.DB.prepare("SELECT * FROM p3_runs WHERE id = ?").bind(id).first<RunRow>();
+}
+
+async function startInstance(env: Phase3Env, runId: string, attempt: number) {
+  const instanceId = `${runId}-a${attempt}`;
+  await env.RUN_WORKFLOW.create({ id: instanceId, params: { runId, attempt } });
+  return instanceId;
+}
+
+async function failRun(env: Phase3Env, runId: string, key: string, msg: string) {
+  await env.DB.batch([
+    env.DB.prepare("UPDATE p3_runs SET status = 'failed', error = ?, updated_at = ? WHERE id = ?").bind(
+      msg,
+      Date.now(),
+      runId,
+    ),
+    runEventStmt(env.DB, runId, key, "failed", msg),
+  ]);
+}
+
+async function limitsPayload(env: Phase3Env) {
+  const limits = readLimits(env);
+  const u = await loadDayUsage(env);
+  return {
+    free_tier_only: limits.freeTierOnly,
+    runs: { used: u.runs, limit: limits.runsPerDay },
+    calls: { used: u.calls, limit: limits.callsPerDay },
+    tokens: { used: u.tokens, limit: limits.tokensPerDay },
+  };
+}
+
+// ---- Kirim tujuan -> mulai alur ----
+runRoutes.post("/", async (c) => {
+  const env = c.env;
+  const parsed = createSchema.safeParse(await c.req.json().catch(() => null));
+  if (!parsed.success) return c.json({ error: "Tujuan wajib diisi (10–4000 karakter) dan template dipilih." }, 400);
+  const tpl = getTemplate(parsed.data.template);
+  if (!tpl) return c.json({ error: "Template alur tidak dikenal." }, 400);
+  const problems = validateSteps(tpl.steps);
+  if (problems.length) return c.json({ error: `Template rusak: ${problems[0]}` }, 500);
+  if (!env.GROQ_API_KEY) return c.json({ error: "GROQ_API_KEY belum diset di Cloudflare." }, 500);
+
+  const limits = readLimits(env);
+  const denied = checkBudget(await loadDayUsage(env), limits, tpl.steps.length, true);
+  if (denied) return c.json({ error: `${denied} Free Tier Only aktif.` }, 429);
+
+  const id = crypto.randomUUID();
+  const now = Date.now();
+  const { goal } = parsed.data;
+  const title = parsed.data.title || goal.replace(/\s+/g, " ").slice(0, 60);
+
+  await env.DB.batch([
+    env.DB.prepare(
+      "INSERT INTO p3_runs (id, title, goal, template, status, attempts, created_at, updated_at) VALUES (?, ?, ?, ?, 'queued', 1, ?, ?)",
+    ).bind(id, title, goal, tpl.id, now, now),
+    ...tpl.steps.map((s, i) =>
+      env.DB.prepare(
+        "INSERT INTO p3_steps (id, run_id, idx, agent, title, depends_on, needs_approval, status, updated_at) VALUES (?, ?, ?, ?, ?, ?, ?, 'pending', ?)",
+      ).bind(`${id}-${i}`, id, i, s.agent, s.title, JSON.stringify(s.dependsOn), s.needsApproval ? 1 : 0, now),
+    ),
+    runEventStmt(env.DB, id, `${id}-1-created`, "created", `Alur "${tpl.id}" diterima (${tpl.steps.length} langkah)`),
+  ]);
+
+  try {
+    const instanceId = await startInstance(env, id, 1);
+    await env.DB.prepare("UPDATE p3_runs SET instance_id = ? WHERE id = ?").bind(instanceId, id).run();
+  } catch (e) {
+    const msg = `Gagal memulai Workflow: ${e instanceof Error ? e.message : String(e)}`;
+    await failRun(env, id, `${id}-1-fail`, msg);
+    return c.json({ error: msg, id }, 502);
+  }
+  return c.json({ id }, 201);
+});
+
+// ---- Daftar alur + batas pemakaian ----
+runRoutes.get("/", async (c) => {
+  const env = c.env;
+  const { results } = await env.DB.prepare(
+    `SELECT r.id, r.title, r.template, r.status, r.attempts, r.instance_id, r.current_step, r.error,
+            r.created_at, r.updated_at,
+            (SELECT COUNT(*) FROM p3_steps s WHERE s.run_id = r.id) AS steps_total,
+            (SELECT COUNT(*) FROM p3_steps s WHERE s.run_id = r.id AND s.status = 'completed') AS steps_done,
+            (SELECT SUM(u.total_tokens) FROM p3_usage_logs u WHERE u.run_id = r.id) AS total_tokens
+     FROM p3_runs r ORDER BY r.created_at DESC LIMIT 50`,
+  ).all<ListRow>();
+  const synced = await Promise.all(results.map((r) => syncStatus(env, r)));
+  return c.json({
+    runs: synced.map(({ instance_id: _i, ...rest }) => rest),
+    limits: await limitsPayload(env),
+    templates: PIPELINE_TEMPLATES.map((t) => ({ id: t.id, label: t.label })),
+  });
+});
+
+// ---- Detail satu alur ----
+runRoutes.get("/:id", async (c) => {
+  const env = c.env;
+  const run = await getRun(env, c.req.param("id"));
+  if (!run) return c.json({ error: "Alur tidak ditemukan." }, 404);
+  const synced = await syncStatus(env, run);
+  const [steps, events] = await Promise.all([
+    env.DB.prepare(
+      `SELECT idx, agent, title, depends_on, needs_approval, status, output, approval_note, provider, model,
+              prompt_tokens, completion_tokens, total_tokens, latency_ms, error
+       FROM p3_steps WHERE run_id = ? ORDER BY idx ASC`,
+    )
+      .bind(run.id)
+      .all<StepDbRow>(),
+    env.DB.prepare("SELECT id, type, message, created_at FROM p3_events WHERE run_id = ? ORDER BY created_at ASC, id ASC")
+      .bind(run.id)
+      .all(),
+  ]);
+  const { instance_id: _i, ...pub } = synced;
+  return c.json({
+    run: pub,
+    steps: steps.results.map((s) => ({
+      ...s,
+      depends_on: JSON.parse(s.depends_on) as number[],
+      needs_approval: s.needs_approval === 1,
+    })),
+    events: events.results,
+  });
+});
+
+// ---- Pause ----
+runRoutes.post("/:id/pause", async (c) => {
+  const env = c.env;
+  const run = await getRun(env, c.req.param("id"));
+  if (!run) return c.json({ error: "Alur tidak ditemukan." }, 404);
+  if (!["queued", "running"].includes(run.status) || !run.instance_id) {
+    return c.json({ error: "Hanya alur yang sedang berjalan yang bisa di-pause." }, 409);
+  }
+  try {
+    const inst = await env.RUN_WORKFLOW.get(run.instance_id);
+    await inst.pause();
+    const s = await inst.status();
+    const next: RunStatus = s.status === "paused" ? "paused" : "pausing";
+    await env.DB.batch([
+      env.DB.prepare("UPDATE p3_runs SET status = ?, updated_at = ? WHERE id = ? AND status IN ('queued','running')").bind(
+        next,
+        Date.now(),
+        run.id,
+      ),
+      runEventStmt(env.DB, run.id, crypto.randomUUID(), "pause", "Pause diminta (berlaku setelah langkah yang sedang jalan selesai)"),
+    ]);
+    return c.json({ status: next });
+  } catch (e) {
+    return c.json({ error: `Gagal pause: ${e instanceof Error ? e.message : String(e)}` }, 409);
+  }
+});
+
+// ---- Resume ----
+runRoutes.post("/:id/resume", async (c) => {
+  const env = c.env;
+  const run = await getRun(env, c.req.param("id"));
+  if (!run) return c.json({ error: "Alur tidak ditemukan." }, 404);
+  if (!["paused", "pausing"].includes(run.status) || !run.instance_id) {
+    return c.json({ error: "Alur tidak sedang di-pause." }, 409);
+  }
+  try {
+    const inst = await env.RUN_WORKFLOW.get(run.instance_id);
+    await inst.resume();
+    // Bila saat dijeda sebuah langkah sudah selesai dan menunggu persetujuan, tampilkan status itu.
+    const waiting = await env.DB.prepare(
+      "SELECT 1 AS x FROM p3_steps WHERE run_id = ? AND status = 'awaiting_approval' LIMIT 1",
+    )
+      .bind(run.id)
+      .first();
+    const next: RunStatus = waiting ? "awaiting_approval" : "running";
+    await env.DB.batch([
+      env.DB.prepare("UPDATE p3_runs SET status = ?, updated_at = ? WHERE id = ? AND status IN ('paused','pausing')").bind(
+        next,
+        Date.now(),
+        run.id,
+      ),
+      runEventStmt(env.DB, run.id, crypto.randomUUID(), "resume", "Dilanjutkan"),
+    ]);
+    return c.json({ status: next });
+  } catch (e) {
+    return c.json({ error: `Gagal resume: ${e instanceof Error ? e.message : String(e)}` }, 409);
+  }
+});
+
+// ---- Setuju / tolak ----
+async function decide(env: Phase3Env, id: string, approved: boolean, note: string | undefined) {
+  const run = await getRun(env, id);
+  if (!run) return { code: 404 as const, error: "Alur tidak ditemukan." };
+  const synced = await syncStatus(env, run);
+  if (synced.status !== "awaiting_approval" || !run.instance_id) {
+    return { code: 409 as const, error: "Alur tidak sedang menunggu persetujuan." };
+  }
+  const waiting = await env.DB.prepare(
+    "SELECT idx FROM p3_steps WHERE run_id = ? AND status = 'awaiting_approval' ORDER BY idx ASC LIMIT 1",
+  )
+    .bind(id)
+    .first<{ idx: number }>();
+  if (!waiting) return { code: 409 as const, error: "Tidak ada langkah yang menunggu persetujuan." };
+
+  // Kunci: cegah dobel klik mengirim dua event.
+  const claim = await env.DB.prepare(
+    "UPDATE p3_runs SET status = 'running', updated_at = ? WHERE id = ? AND status = 'awaiting_approval'",
+  )
+    .bind(Date.now(), id)
+    .run();
+  if (!claim.meta.changes) return { code: 409 as const, error: "Keputusan sudah dikirim." };
+
+  try {
+    const inst = await env.RUN_WORKFLOW.get(run.instance_id);
+    await inst.sendEvent({ type: `approval-${waiting.idx}`, payload: { approved, note } });
+  } catch (e) {
+    await env.DB.prepare("UPDATE p3_runs SET status = 'awaiting_approval', updated_at = ? WHERE id = ?")
+      .bind(Date.now(), id)
+      .run();
+    return { code: 502 as const, error: `Gagal mengirim keputusan: ${e instanceof Error ? e.message : String(e)}` };
+  }
+  return { code: 200 as const, error: null };
+}
+
+for (const [path, approved] of [
+  ["approve", true],
+  ["reject", false],
+] as const) {
+  runRoutes.post(`/:id/${path}`, async (c) => {
+    const body = noteSchema.safeParse(await c.req.json().catch(() => ({})));
+    if (!body.success) return c.json({ error: "Catatan maksimal 500 karakter." }, 400);
+    const r = await decide(c.env, c.req.param("id"), approved, body.data.note);
+    if (r.error) return c.json({ error: r.error }, r.code);
+    return c.json({ status: approved ? "running" : "rejecting" });
+  });
+}
+
+// ---- Retry (instance baru; langkah yang sudah selesai dilewati) ----
+runRoutes.post("/:id/retry", async (c) => {
+  const env = c.env;
+  const run = await getRun(env, c.req.param("id"));
+  if (!run) return c.json({ error: "Alur tidak ditemukan." }, 404);
+  if (!["failed", "rejected"].includes(run.status)) {
+    return c.json({ error: "Hanya alur gagal atau ditolak yang bisa di-retry." }, 409);
+  }
+  if (run.attempts >= MAX_ATTEMPTS) return c.json({ error: `Batas ${MAX_ATTEMPTS} percobaan tercapai.` }, 409);
+
+  const attempt = run.attempts + 1;
+  const batch = await env.DB.batch([
+    env.DB.prepare(
+      "UPDATE p3_runs SET status = 'queued', attempts = ?, error = NULL, updated_at = ? WHERE id = ? AND status IN ('failed','rejected')",
+    ).bind(attempt, Date.now(), run.id),
+    // Langkah selesai tetap; yang gagal/ditolak/terputus diulang. 'awaiting_approval' dipertahankan
+    // (hasilnya sudah ada, cukup minta persetujuan lagi tanpa memanggil AI).
+    env.DB.prepare(
+      "UPDATE p3_steps SET status = 'pending', error = NULL, updated_at = ? WHERE run_id = ? AND status IN ('failed','rejected','running')",
+    ).bind(Date.now(), run.id),
+    runEventStmt(env.DB, run.id, `${run.id}-${attempt}-retry`, "retry", `Retry: percobaan ${attempt}`),
+  ]);
+  if (!batch[0]?.meta.changes) return c.json({ error: "Alur sudah diproses ulang." }, 409);
+
+  try {
+    const instanceId = await startInstance(env, run.id, attempt);
+    await env.DB.prepare("UPDATE p3_runs SET instance_id = ? WHERE id = ?").bind(instanceId, run.id).run();
+  } catch (e) {
+    const msg = `Gagal memulai Workflow: ${e instanceof Error ? e.message : String(e)}`;
+    await failRun(env, run.id, `${run.id}-${attempt}-fail`, msg);
+    return c.json({ error: msg }, 502);
+  }
+  return c.json({ status: "queued", attempt });
+});
diff --git a/apps/api/src/phase3/shared.ts b/apps/api/src/phase3/shared.ts
new file mode 100644
index 0000000..ebfef8d
--- /dev/null
+++ b/apps/api/src/phase3/shared.ts
@@ -0,0 +1,35 @@
+// Tipe + helper bersama untuk Fase 3 (tim multi-agent).
+
+import type { Phase2Env } from "../phase2/shared";
+
+export interface RunParams {
+  runId: string;
+  attempt: number;
+}
+
+export interface Phase3Env extends Phase2Env {
+  RUN_WORKFLOW: Workflow<RunParams>;
+  /** "false" mematikan mode Free Tier Only. Selain itu (termasuk kosong) = aktif. */
+  FREE_TIER_ONLY?: string;
+  MAX_RUNS_PER_DAY?: string;
+  MAX_AI_CALLS_PER_DAY?: string;
+  MAX_TOKENS_PER_DAY?: string;
+}
+
+export function runEventStmt(
+  db: D1Database,
+  runId: string,
+  id: string,
+  type: string,
+  message: string,
+): D1PreparedStatement {
+  return db
+    .prepare("INSERT OR REPLACE INTO p3_events (id, run_id, type, message, created_at) VALUES (?, ?, ?, ?, ?)")
+    .bind(id, runId, type, message, Date.now());
+}
+
+export function dayStartMs(now = Date.now()): number {
+  const d = new Date(now);
+  d.setUTCHours(0, 0, 0, 0);
+  return d.getTime();
+}
diff --git a/apps/api/src/phase3/workflow.ts b/apps/api/src/phase3/workflow.ts
new file mode 100644
index 0000000..960eb22
--- /dev/null
+++ b/apps/api/src/phase3/workflow.ts
@@ -0,0 +1,292 @@
+// Cloudflare Workflow: satu alur multi-agent (Analyst -> Architect -> ... -> QA).
+// Langkah dijalankan berurutan sesuai indeks; hasil dependensi dikirim sebagai konteks.
+// Langkah bertanda needsApproval berhenti di waitForEvent sampai pemilik setuju/tolak.
+// Semua status/hasil/token ada di D1, jadi tetap terlihat setelah browser ditutup.
+
+import { WorkflowEntrypoint, type WorkflowEvent, type WorkflowStep } from "cloudflare:workers";
+import { NonRetryableError } from "cloudflare:workflows";
+import { AiError, createProvider } from "../phase2/ai";
+import { buildMessages, checkBudget, isProviderAllowed, readLimits, type DepOutput } from "./pipeline";
+import { dayStartMs, runEventStmt, type Phase3Env, type RunParams } from "./shared";
+
+interface StepRow {
+  idx: number;
+  agent: string;
+  title: string;
+  depends_on: string;
+  needs_approval: number;
+  status: string;
+  output: string | null;
+  approval_note: string | null;
+}
+
+type Prepared =
+  | { action: "skip" }
+  | { action: "approve" }
+  | {
+      action: "run";
+      agent: string;
+      title: string;
+      needsApproval: boolean;
+      goal: string;
+      deps: DepOutput[];
+      previousOutput: string | null;
+      note: string | null;
+    };
+
+interface ApprovalPayload {
+  approved: boolean;
+  note?: string;
+}
+
+// Jangan menimpa status pause yang diminta pemilik saat langkah sedang selesai.
+const SET_ACTIVE =
+  "UPDATE p3_runs SET status = CASE WHEN status IN ('pausing','paused') THEN status ELSE ? END, current_step = ?, error = NULL, updated_at = ? WHERE id = ?";
+
+export async function loadDayUsage(env: Phase3Env) {
+  const start = dayStartMs();
+  const [runs, p3, p2] = await Promise.all([
+    env.DB.prepare("SELECT COUNT(*) AS n FROM p3_runs WHERE created_at >= ?").bind(start).first<{ n: number }>(),
+    env.DB.prepare("SELECT COUNT(*) AS n, SUM(total_tokens) AS t FROM p3_usage_logs WHERE created_at >= ?")
+      .bind(start)
+      .first<{ n: number; t: number | null }>(),
+    env.DB.prepare("SELECT COUNT(*) AS n, SUM(total_tokens) AS t FROM p2_usage_logs WHERE created_at >= ?")
+      .bind(start)
+      .first<{ n: number; t: number | null }>(),
+  ]);
+  return {
+    runs: runs?.n ?? 0,
+    calls: (p3?.n ?? 0) + (p2?.n ?? 0),
+    tokens: (p3?.t ?? 0) + (p2?.t ?? 0),
+  };
+}
+
+export class PipelineRunWorkflow extends WorkflowEntrypoint<Phase3Env, RunParams> {
+  async run(event: WorkflowEvent<RunParams>, step: WorkflowStep) {
+    const { runId, attempt } = event.payload;
+    const env = this.env;
+    let currentIdx: number | null = null;
+
+    try {
+      const info = await step.do("load-run", async () => {
+        const run = await env.DB.prepare("SELECT goal FROM p3_runs WHERE id = ?")
+          .bind(runId)
+          .first<{ goal: string }>();
+        if (!run) throw new NonRetryableError("Alur tidak ditemukan di D1");
+        const { results } = await env.DB.prepare("SELECT idx FROM p3_steps WHERE run_id = ? ORDER BY idx ASC")
+          .bind(runId)
+          .all<{ idx: number }>();
+        if (results.length === 0) throw new NonRetryableError("Alur tidak punya langkah");
+        await env.DB.batch([
+          env.DB.prepare(SET_ACTIVE).bind("running", null, Date.now(), runId),
+          runEventStmt(env.DB, runId, `${runId}-${attempt}-start`, "running", `Percobaan ${attempt} dimulai`),
+        ]);
+        return { goal: run.goal, indexes: results.map((r) => r.idx) };
+      });
+
+      for (const idx of info.indexes) {
+        currentIdx = idx;
+
+        // 1) Baca keadaan langkah + periksa batas harian. Hasilnya di-cache Workflow.
+        const prep = await step.do(`s${idx}-prepare`, async (): Promise<Prepared> => {
+          const row = await env.DB.prepare(
+            "SELECT idx, agent, title, depends_on, needs_approval, status, output, approval_note FROM p3_steps WHERE run_id = ? AND idx = ?",
+          )
+            .bind(runId, idx)
+            .first<StepRow>();
+          if (!row) throw new NonRetryableError(`Langkah ${idx} tidak ada`);
+          if (row.status === "completed") return { action: "skip" };
+          if (row.status === "awaiting_approval") {
+            await env.DB.prepare(SET_ACTIVE).bind("awaiting_approval", idx, Date.now(), runId).run();
+            return { action: "approve" };
+          }
+
+          const limits = readLimits(env);
+          const need = checkBudget(await loadDayUsage(env), limits, 1, false);
+          if (need) throw new NonRetryableError(`${need} Free Tier Only: coba lagi setelah reset 00:00 UTC.`);
+
+          const depIdx = JSON.parse(row.depends_on) as number[];
+          const deps: DepOutput[] = [];
+          for (const d of depIdx) {
+            const dep = await env.DB.prepare(
+              "SELECT agent, title, output FROM p3_steps WHERE run_id = ? AND idx = ? AND status = 'completed'",
+            )
+              .bind(runId, d)
+              .first<{ agent: string; title: string; output: string | null }>();
+            if (!dep?.output) throw new NonRetryableError(`Dependensi langkah ${d} belum selesai`);
+            deps.push({ agent: dep.agent, title: dep.title, output: dep.output });
+          }
+
+          const now = Date.now();
+          await env.DB.batch([
+            env.DB.prepare("UPDATE p3_steps SET status = 'running', error = NULL, updated_at = ? WHERE run_id = ? AND idx = ?").bind(
+              now,
+              runId,
+              idx,
+            ),
+            env.DB.prepare(SET_ACTIVE).bind("running", idx, now, runId),
+            runEventStmt(env.DB, runId, `${runId}-${attempt}-s${idx}-start`, "step", `${row.title}: dimulai`),
+          ]);
+          return {
+            action: "run",
+            agent: row.agent,
+            title: row.title,
+            needsApproval: row.needs_approval === 1,
+            goal: info.goal,
+            deps,
+            previousOutput: row.output,
+            note: row.approval_note,
+          };
+        });
+
+        if (prep.action === "skip") continue;
+
+        let needsApproval = true;
+
+        if (prep.action === "run") {
+          needsApproval = prep.needsApproval;
+
+          // 2) Panggil AI (retry + backoff untuk 429/5xx).
+          const ai = await step.do(
+            `s${idx}-ai`,
+            { retries: { limit: 4, delay: "15 seconds", backoff: "exponential" }, timeout: "90 seconds" },
+            async () => {
+              try {
+                const provider = createProvider(env);
+                if (!isProviderAllowed(provider.name, readLimits(env).freeTierOnly)) {
+                  throw new NonRetryableError(`Penyedia "${provider.name}" tidak gratis; Free Tier Only aktif.`);
+                }
+                const { messages, maxTokens } = buildMessages({
+                  agent: prep.agent,
+                  title: prep.title,
+                  goal: prep.goal,
+                  deps: prep.deps,
+                  previousOutput: prep.previousOutput,
+                  note: prep.note,
+                });
+                return await provider.complete(messages, { maxTokens });
+              } catch (e) {
+                if (e instanceof AiError && !e.retryable) throw new NonRetryableError(e.message);
+                throw e;
+              }
+            },
+          );
+
+          // 3) Simpan hasil + token apa adanya dari penyedia.
+          await step.do(`s${idx}-save`, async () => {
+            const now = Date.now();
+            const nextStep = needsApproval ? "awaiting_approval" : "completed";
+            await env.DB.batch([
+              env.DB.prepare(
+                `INSERT OR REPLACE INTO p3_usage_logs
+                 (id, run_id, step_idx, attempt, agent, provider, model, prompt_tokens, completion_tokens, total_tokens, latency_ms, created_at)
+                 VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,
+              ).bind(
+                `${runId}-${attempt}-s${idx}`,
+                runId,
+                idx,
+                attempt,
+                prep.agent,
+                ai.provider,
+                ai.model,
+                ai.usage.promptTokens,
+                ai.usage.completionTokens,
+                ai.usage.totalTokens,
+                ai.latencyMs,
+                now,
+              ),
+              env.DB.prepare(
+                `UPDATE p3_steps SET status = ?, output = ?, approval_note = NULL, provider = ?, model = ?,
+                   prompt_tokens = ?, completion_tokens = ?, total_tokens = ?, latency_ms = ?, error = NULL, updated_at = ?
+                 WHERE run_id = ? AND idx = ?`,
+              ).bind(
+                nextStep,
+                ai.text,
+                ai.provider,
+                ai.model,
+                ai.usage.promptTokens,
+                ai.usage.completionTokens,
+                ai.usage.totalTokens,
+                ai.latencyMs,
+                now,
+                runId,
+                idx,
+              ),
+              env.DB.prepare(SET_ACTIVE).bind(needsApproval ? "awaiting_approval" : "running", idx, now, runId),
+              runEventStmt(
+                env.DB,
+                runId,
+                `${runId}-${attempt}-s${idx}-done`,
+                needsApproval ? "approval" : "step",
+                needsApproval
+                  ? `${prep.title}: selesai, menunggu persetujuan`
+                  : `${prep.title}: selesai (${ai.provider}/${ai.model}, ${ai.latencyMs} ms)`,
+              ),
+            ]);
+          });
+        }
+
+        // 4) Persetujuan pemilik (bila langkah ini memintanya).
+        if (needsApproval) {
+          const decision = await step.waitForEvent<ApprovalPayload>(`s${idx}-approval`, {
+            type: `approval-${idx}`,
+            timeout: "3 days",
+          });
+          const approved = decision.payload.approved === true;
+          const note = (decision.payload.note ?? "").slice(0, 500) || null;
+
+          await step.do(`s${idx}-decide`, async () => {
+            const now = Date.now();
+            await env.DB.batch([
+              env.DB.prepare(
+                "UPDATE p3_steps SET status = ?, approval_note = ?, updated_at = ? WHERE run_id = ? AND idx = ?",
+              ).bind(approved ? "completed" : "rejected", note, now, runId, idx),
+              approved
+                ? env.DB.prepare(SET_ACTIVE).bind("running", idx, now, runId)
+                : env.DB.prepare(
+                    "UPDATE p3_runs SET status = 'rejected', current_step = ?, updated_at = ? WHERE id = ?",
+                  ).bind(idx, now, runId),
+              runEventStmt(
+                env.DB,
+                runId,
+                `${runId}-${attempt}-s${idx}-decide`,
+                approved ? "approved" : "rejected",
+                `${approved ? "Disetujui" : "Ditolak"}${note ? `: ${note}` : ""}`,
+              ),
+            ]);
+          });
+
+          if (!approved) return { runId, status: "rejected" };
+        }
+      }
+
+      await step.do("finish", async () => {
+        const now = Date.now();
+        await env.DB.batch([
+          env.DB.prepare(
+            "UPDATE p3_runs SET status = 'completed', current_step = NULL, error = NULL, updated_at = ? WHERE id = ?",
+          ).bind(now, runId),
+          runEventStmt(env.DB, runId, `${runId}-${attempt}-done`, "completed", "Seluruh alur selesai"),
+        ]);
+      });
+      return { runId, status: "completed" };
+    } catch (err) {
+      const msg = (err instanceof Error ? err.message : String(err)).slice(0, 500);
+      await step.do("mark-failed", async () => {
+        const now = Date.now();
+        await env.DB.batch([
+          env.DB.prepare(
+            "UPDATE p3_steps SET status = 'failed', error = ?, updated_at = ? WHERE run_id = ? AND idx = ? AND status = 'running'",
+          ).bind(msg, now, runId, currentIdx ?? -1),
+          env.DB.prepare("UPDATE p3_runs SET status = 'failed', error = ?, updated_at = ? WHERE id = ?").bind(
+            msg,
+            now,
+            runId,
+          ),
+          runEventStmt(env.DB, runId, `${runId}-${attempt}-fail`, "failed", msg),
+        ]);
+      });
+      throw err;
+    }
+  }
+}
