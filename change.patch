@@ -4,29 +4,68 @@ import type { AppEnv } from "../env";
 
 export const RATE_LIMIT_RETENTION_SEC = 60 * 60; // 1 jam
 export const AUDIT_RETENTION_MS = 90 * 24 * 60 * 60 * 1000; // 90 hari
+export const EVENTS_RETENTION_MS = 30 * 24 * 60 * 60 * 1000; // 30 hari
+export const USAGE_RETENTION_MS = 90 * 24 * 60 * 60 * 1000; // 90 hari
 export const CLEANUP_INTERVAL_MS = 12 * 60 * 60 * 1000; // paling sering tiap 12 jam
 
 const MUTATING = new Set(["POST", "PUT", "PATCH", "DELETE"]);
 
-export function cutoffs(nowMs: number): { rateLimitBeforeSec: number; auditBeforeMs: number } {
+export function cutoffs(nowMs: number): {
+  rateLimitBeforeSec: number;
+  auditBeforeMs: number;
+  eventsBeforeMs: number;
+  usageBeforeMs: number;
+  nowMs: number;
+} {
   return {
     rateLimitBeforeSec: Math.floor(nowMs / 1000) - RATE_LIMIT_RETENTION_SEC,
     auditBeforeMs: nowMs - AUDIT_RETENTION_MS,
+    eventsBeforeMs: nowMs - EVENTS_RETENTION_MS,
+    usageBeforeMs: nowMs - USAGE_RETENTION_MS,
+    nowMs,
   };
 }
 
+/** Kolom waktu tabel lama bisa detik atau milidetik; bandingkan selalu dalam milidetik. */
+export function msExpr(col: string): string {
+  return `(CASE WHEN ${col} > 100000000000 THEN ${col} ELSE ${col} * 1000 END)`;
+}
+
 export interface CleanupResult {
   rateLimitsDeleted: number;
   auditDeleted: number;
+  legacy: Record<string, number>;
 }
 
 export async function runCleanup(db: D1Database, nowMs: number): Promise<CleanupResult> {
   const c = cutoffs(nowMs);
   const rl = await db.prepare("DELETE FROM p6_rate_limits WHERE window_start < ?1").bind(c.rateLimitBeforeSec).run();
   const au = await db.prepare("DELETE FROM p6_audit_log WHERE ts < ?1").bind(c.auditBeforeMs).run();
+
+  // Tabel lama: tiap penghapusan berdiri sendiri, satu gagal tidak menghentikan yang lain.
+  const legacyJobs: Array<[string, string, number]> = [
+    ["sessions", `DELETE FROM sessions WHERE ${msExpr("expires_at")} < ?1`, c.nowMs],
+    ["audit_logs", `DELETE FROM audit_logs WHERE ${msExpr("ts")} < ?1`, c.auditBeforeMs],
+    ["p2_task_events", `DELETE FROM p2_task_events WHERE ${msExpr("created_at")} < ?1`, c.eventsBeforeMs],
+    ["p3_events", `DELETE FROM p3_events WHERE ${msExpr("created_at")} < ?1`, c.eventsBeforeMs],
+    ["p2_usage_logs", `DELETE FROM p2_usage_logs WHERE ${msExpr("created_at")} < ?1`, c.usageBeforeMs],
+    ["p3_usage_logs", `DELETE FROM p3_usage_logs WHERE ${msExpr("created_at")} < ?1`, c.usageBeforeMs],
+  ];
+  const legacy: Record<string, number> = {};
+  for (const [name, sql, bound] of legacyJobs) {
+    try {
+      const r = await db.prepare(sql).bind(bound).run();
+      legacy[name] = r.meta?.changes ?? 0;
+    } catch (err) {
+      console.error(`cleanup: ${name} gagal`, err);
+      legacy[name] = -1;
+    }
+  }
+
   return {
     rateLimitsDeleted: rl.meta?.changes ?? 0,
     auditDeleted: au.meta?.changes ?? 0,
+    legacy,
   };
 }
 
