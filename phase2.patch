@@ -0,0 +1,55 @@
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { AiError, GroqProvider, createProvider } from "./ai";
+
+const msgs = [{ role: "user" as const, content: "halo" }];
+
+function mockFetch(status: number, body: unknown) {
+  vi.stubGlobal(
+    "fetch",
+    vi.fn(async () => new Response(typeof body === "string" ? body : JSON.stringify(body), { status })),
+  );
+}
+
+afterEach(() => vi.unstubAllGlobals());
+
+describe("GroqProvider", () => {
+  it("memakai angka token apa adanya dari respons", async () => {
+    mockFetch(200, {
+      model: "m-real",
+      choices: [{ message: { content: "hai" } }],
+      usage: { prompt_tokens: 5, completion_tokens: 7, total_tokens: 12 },
+    });
+    const r = await new GroqProvider("k", "m").complete(msgs);
+    expect(r.text).toBe("hai");
+    expect(r.model).toBe("m-real");
+    expect(r.usage).toEqual({ promptTokens: 5, completionTokens: 7, totalTokens: 12 });
+  });
+
+  it("token null (bukan tebakan) bila penyedia tidak mengirim usage", async () => {
+    mockFetch(200, { choices: [{ message: { content: "hai" } }] });
+    const r = await new GroqProvider("k", "m").complete(msgs);
+    expect(r.usage).toEqual({ promptTokens: null, completionTokens: null, totalTokens: null });
+  });
+
+  it.each([
+    [429, true],
+    [500, true],
+    [401, false],
+    [400, false],
+  ])("HTTP %i -> retryable=%s", async (status, retryable) => {
+    mockFetch(status, "err");
+    const err = await new GroqProvider("k", "m").complete(msgs).catch((e: unknown) => e);
+    expect(err).toBeInstanceOf(AiError);
+    expect((err as AiError).retryable).toBe(retryable);
+  });
+
+  it("respons kosong dianggap error yang boleh dicoba ulang", async () => {
+    mockFetch(200, { choices: [{ message: { content: "  " } }] });
+    const err = await new GroqProvider("k", "m").complete(msgs).catch((e: unknown) => e);
+    expect((err as AiError).retryable).toBe(true);
+  });
+
+  it("createProvider menolak bila API key belum diset", () => {
+    expect(() => createProvider({})).toThrow(AiError);
+  });
+});
diff --git a/apps/api/src/phase2/ai.ts b/apps/api/src/phase2/ai.ts
new file mode 100644
index 0000000..60f192a
--- /dev/null
+++ b/apps/api/src/phase2/ai.ts
@@ -0,0 +1,127 @@
+// Adapter penyedia AI. Fase 2: Groq. Gemini / OpenRouter nanti tinggal tambah class baru.
+// Angka token = apa adanya dari respons penyedia. Kalau tidak ada -> null (tidak ditebak).
+
+export interface ChatMessage {
+  role: "system" | "user" | "assistant";
+  content: string;
+}
+
+export interface AiUsage {
+  promptTokens: number | null;
+  completionTokens: number | null;
+  totalTokens: number | null;
+}
+
+export interface AiResult {
+  text: string;
+  usage: AiUsage;
+  provider: string;
+  model: string;
+  latencyMs: number;
+}
+
+export interface AiOptions {
+  maxTokens?: number;
+  temperature?: number;
+}
+
+export interface AiProvider {
+  readonly name: string;
+  complete(messages: ChatMessage[], opts?: AiOptions): Promise<AiResult>;
+}
+
+export class AiError extends Error {
+  constructor(
+    message: string,
+    public readonly status: number | null,
+    public readonly retryable: boolean,
+  ) {
+    super(message);
+    this.name = "AiError";
+  }
+}
+
+interface GroqResponse {
+  model?: string;
+  choices?: { message?: { content?: string | null } }[];
+  usage?: {
+    prompt_tokens?: number;
+    completion_tokens?: number;
+    total_tokens?: number;
+  };
+}
+
+const GROQ_URL = "https://api.groq.com/openai/v1/chat/completions";
+const GROQ_DEFAULT_MODEL = "llama-3.3-70b-versatile";
+
+export class GroqProvider implements AiProvider {
+  readonly name = "groq";
+
+  constructor(
+    private readonly apiKey: string,
+    private readonly model: string = GROQ_DEFAULT_MODEL,
+  ) {}
+
+  async complete(
+    messages: ChatMessage[],
+    opts: AiOptions = {},
+  ): Promise<AiResult> {
+    const started = Date.now();
+    let res: Response;
+    try {
+      res = await fetch(GROQ_URL, {
+        method: "POST",
+        headers: {
+          Authorization: `Bearer ${this.apiKey}`,
+          "Content-Type": "application/json",
+        },
+        body: JSON.stringify({
+          model: this.model,
+          messages,
+          max_tokens: opts.maxTokens ?? 1024,
+          temperature: opts.temperature ?? 0.4,
+        }),
+        signal: AbortSignal.timeout(45_000),
+      });
+    } catch (e) {
+      throw new AiError(
+        `Groq tidak terjangkau: ${e instanceof Error ? e.message : String(e)}`,
+        null,
+        true,
+      );
+    }
+
+    if (!res.ok) {
+      const body = (await res.text().catch(() => "")).slice(0, 300);
+      // 429 (rate limit) & 5xx layak dicoba ulang; 400/401/403/404 tidak.
+      const retryable = res.status === 429 || res.status >= 500;
+      throw new AiError(`Groq ${res.status}: ${body}`, res.status, retryable);
+    }
+
+    const data = (await res.json()) as GroqResponse;
+    const text = data.choices?.[0]?.message?.content ?? "";
+    if (!text.trim()) throw new AiError("Groq: respons kosong", null, true);
+
+    return {
+      text,
+      usage: {
+        promptTokens: data.usage?.prompt_tokens ?? null,
+        completionTokens: data.usage?.completion_tokens ?? null,
+        totalTokens: data.usage?.total_tokens ?? null,
+      },
+      provider: this.name,
+      model: data.model ?? this.model,
+      latencyMs: Date.now() - started,
+    };
+  }
+}
+
+export function createProvider(env: {
+  GROQ_API_KEY?: string;
+  GROQ_MODEL?: string;
+}): AiProvider {
+  if (!env.GROQ_API_KEY) {
+    throw new AiError("GROQ_API_KEY belum diset di Cloudflare.", null, false);
+  }
+  return new GroqProvider(env.GROQ_API_KEY, env.GROQ_MODEL || GROQ_DEFAULT_MODEL);
+}
diff --git a/apps/api/src/phase2/routes.ts b/apps/api/src/phase2/routes.ts
new file mode 100644
index 0000000..6d16bac
--- /dev/null
+++ b/apps/api/src/phase2/routes.ts
@@ -0,0 +1,283 @@
+// API tugas Fase 2. Pasang SETELAH middleware auth pemilik:
+//   app.route("/api/tasks", taskRoutes);
+
+import { Hono } from "hono";
+import { z } from "zod";
+import { eventStmt, type Phase2Env, type TaskStatus } from "./shared";
+
+const MAX_ATTEMPTS = 5;
+const ACTIVE: TaskStatus[] = ["queued", "running", "pausing", "paused"];
+
+interface TaskRow {
+  id: string;
+  title: string;
+  prompt: string;
+  agent: string;
+  status: TaskStatus;
+  attempts: number;
+  instance_id: string | null;
+  provider: string | null;
+  model: string | null;
+  result: string | null;
+  error: string | null;
+  created_at: number;
+  updated_at: number;
+}
+
+interface ListRow {
+  id: string;
+  title: string;
+  status: TaskStatus;
+  attempts: number;
+  instance_id: string | null;
+  provider: string | null;
+  model: string | null;
+  error: string | null;
+  created_at: number;
+  updated_at: number;
+  total_tokens: number | null;
+}
+
+export const taskRoutes = new Hono<{ Bindings: Phase2Env }>();
+
+const createSchema = z.object({
+  prompt: z.string().trim().min(3).max(4000),
+  title: z.string().trim().max(80).optional(),
+});
+
+function dayStartMs(): number {
+  const d = new Date();
+  d.setUTCHours(0, 0, 0, 0);
+  return d.getTime();
+}
+
+function dailyLimit(env: Phase2Env): number {
+  const n = Number(env.MAX_TASKS_PER_DAY);
+  return Number.isFinite(n) && n > 0 ? n : 50;
+}
+
+function mapInstance(s: string): TaskStatus | null {
+  switch (s) {
+    case "queued":
+      return "queued";
+    case "running":
+    case "waiting":
+      return "running";
+    case "waitingForPause":
+      return "pausing";
+    case "paused":
+      return "paused";
+    case "errored":
+    case "terminated":
+      return "failed";
+    default:
+      return null; // complete / unknown: biarkan Workflow yang menulis ke D1
+  }
+}
+
+// Samakan status D1 dengan status instance Workflow yang sebenarnya.
+async function syncStatus<
+  T extends { id: string; status: TaskStatus; instance_id: string | null; error: string | null },
+>(env: Phase2Env, task: T): Promise<T> {
+  if (!ACTIVE.includes(task.status) || !task.instance_id) return task;
+  try {
+    const inst = await env.TASK_WORKFLOW.get(task.instance_id);
+    const s = await inst.status();
+    const mapped = mapInstance(s.status);
+    if (!mapped || mapped === task.status) return task;
+    const rawErr = s.error as unknown;
+    const err =
+      mapped === "failed"
+        ? typeof rawErr === "string"
+          ? rawErr
+          : ((rawErr as { message?: string } | undefined)?.message ?? `Workflow ${s.status}`)
+        : null;
+    const res = await env.DB.prepare(
+      "UPDATE p2_tasks SET status = ?, error = COALESCE(?, error), updated_at = ? WHERE id = ? AND status = ?",
+    )
+      .bind(mapped, err, Date.now(), task.id, task.status)
+      .run();
+    if (!res.meta.changes) return task;
+    return { ...task, status: mapped, error: err ?? task.error };
+  } catch {
+    return task;
+  }
+}
+
+function getTask(env: Phase2Env, id: string) {
+  return env.DB.prepare("SELECT * FROM p2_tasks WHERE id = ?").bind(id).first<TaskRow>();
+}
+
+async function startInstance(env: Phase2Env, taskId: string, attempt: number) {
+  const instanceId = `${taskId}-a${attempt}`;
+  await env.TASK_WORKFLOW.create({ id: instanceId, params: { taskId, attempt } });
+  return instanceId;
+}
+
+async function failTask(env: Phase2Env, taskId: string, key: string, msg: string) {
+  await env.DB.batch([
+    env.DB.prepare(
+      "UPDATE p2_tasks SET status = 'failed', error = ?, updated_at = ? WHERE id = ?",
+    ).bind(msg, Date.now(), taskId),
+    eventStmt(env.DB, taskId, key, "failed", msg),
+  ]);
+}
+
+// ---- Kirim tugas ----
+taskRoutes.post("/", async (c) => {
+  const env = c.env;
+  const parsed = createSchema.safeParse(await c.req.json().catch(() => null));
+  if (!parsed.success) return c.json({ error: "Prompt wajib diisi (3–4000 karakter)." }, 400);
+  if (!env.GROQ_API_KEY) return c.json({ error: "GROQ_API_KEY belum diset di Cloudflare." }, 500);
+
+  const limit = dailyLimit(env);
+  const today = await env.DB.prepare("SELECT COUNT(*) AS n FROM p2_tasks WHERE created_at >= ?")
+    .bind(dayStartMs())
+    .first<{ n: number }>();
+  if ((today?.n ?? 0) >= limit) {
+    return c.json({ error: `Batas ${limit} tugas/hari (UTC) tercapai. Free Tier Only aktif.` }, 429);
+  }
+
+  const id = crypto.randomUUID();
+  const now = Date.now();
+  const { prompt } = parsed.data;
+  const title = parsed.data.title || prompt.replace(/\s+/g, " ").slice(0, 60);
+
+  await env.DB.batch([
+    env.DB.prepare(
+      "INSERT INTO p2_tasks (id, title, prompt, status, attempts, created_at, updated_at) VALUES (?, ?, ?, 'queued', 1, ?, ?)",
+    ).bind(id, title, prompt, now, now),
+    eventStmt(env.DB, id, `${id}-1-created`, "created", "Tugas diterima"),
+  ]);
+
+  try {
+    const instanceId = await startInstance(env, id, 1);
+    await env.DB.prepare("UPDATE p2_tasks SET instance_id = ? WHERE id = ?").bind(instanceId, id).run();
+  } catch (e) {
+    const msg = `Gagal memulai Workflow: ${e instanceof Error ? e.message : String(e)}`;
+    await failTask(env, id, `${id}-1-fail`, msg);
+    return c.json({ error: msg, id }, 502);
+  }
+  return c.json({ id }, 201);
+});
+
+// ---- Daftar tugas + ringkasan hari ini ----
+taskRoutes.get("/", async (c) => {
+  const env = c.env;
+  const { results } = await env.DB.prepare(
+    `SELECT t.id, t.title, t.status, t.attempts, t.instance_id, t.provider, t.model, t.error,
+            t.created_at, t.updated_at,
+            (SELECT SUM(u.total_tokens) FROM p2_usage_logs u WHERE u.task_id = t.id) AS total_tokens
+     FROM p2_tasks t ORDER BY t.created_at DESC LIMIT 50`,
+  ).all<ListRow>();
+
+  const synced = await Promise.all(results.map((r) => syncStatus(env, r)));
+  const start = dayStartMs();
+  const [n, tok] = await Promise.all([
+    env.DB.prepare("SELECT COUNT(*) AS n FROM p2_tasks WHERE created_at >= ?").bind(start).first<{ n: number }>(),
+    env.DB.prepare("SELECT SUM(total_tokens) AS t FROM p2_usage_logs WHERE created_at >= ?").bind(start).first<{ t: number | null }>(),
+  ]);
+
+  return c.json({
+    tasks: synced.map(({ instance_id: _i, ...rest }) => rest),
+    today: { tasks: n?.n ?? 0, tokens: tok?.t ?? null, limit: dailyLimit(env) },
+  });
+});
+
+// ---- Detail satu tugas ----
+taskRoutes.get("/:id", async (c) => {
+  const env = c.env;
+  const task = await getTask(env, c.req.param("id"));
+  if (!task) return c.json({ error: "Tugas tidak ditemukan." }, 404);
+  const synced = await syncStatus(env, task);
+  const [events, usage] = await Promise.all([
+    env.DB.prepare("SELECT id, type, message, created_at FROM p2_task_events WHERE task_id = ? ORDER BY created_at ASC, id ASC")
+      .bind(task.id)
+      .all(),
+    env.DB.prepare(
+      "SELECT attempt, provider, model, prompt_tokens, completion_tokens, total_tokens, latency_ms, created_at FROM p2_usage_logs WHERE task_id = ? ORDER BY attempt ASC",
+    )
+      .bind(task.id)
+      .all(),
+  ]);
+  const { instance_id: _i, ...pub } = synced;
+  return c.json({ task: pub, events: events.results, usage: usage.results });
+});
+
+// ---- Pause ----
+taskRoutes.post("/:id/pause", async (c) => {
+  const env = c.env;
+  const task = await getTask(env, c.req.param("id"));
+  if (!task) return c.json({ error: "Tugas tidak ditemukan." }, 404);
+  if (!["queued", "running"].includes(task.status) || !task.instance_id) {
+    return c.json({ error: "Hanya tugas yang sedang berjalan yang bisa di-pause." }, 409);
+  }
+  try {
+    const inst = await env.TASK_WORKFLOW.get(task.instance_id);
+    await inst.pause();
+    const s = await inst.status();
+    const next: TaskStatus = s.status === "paused" ? "paused" : "pausing";
+    await env.DB.batch([
+      env.DB.prepare(
+        "UPDATE p2_tasks SET status = ?, updated_at = ? WHERE id = ? AND status IN ('queued','running')",
+      ).bind(next, Date.now(), task.id),
+      eventStmt(env.DB, task.id, crypto.randomUUID(), "pause", "Pause diminta (berlaku setelah langkah yang sedang jalan selesai)"),
+    ]);
+    return c.json({ status: next });
+  } catch (e) {
+    return c.json({ error: `Gagal pause: ${e instanceof Error ? e.message : String(e)}` }, 409);
+  }
+});
+
+// ---- Resume ----
+taskRoutes.post("/:id/resume", async (c) => {
+  const env = c.env;
+  const task = await getTask(env, c.req.param("id"));
+  if (!task) return c.json({ error: "Tugas tidak ditemukan." }, 404);
+  if (!["paused", "pausing"].includes(task.status) || !task.instance_id) {
+    return c.json({ error: "Tugas tidak sedang di-pause." }, 409);
+  }
+  try {
+    const inst = await env.TASK_WORKFLOW.get(task.instance_id);
+    await inst.resume();
+    await env.DB.batch([
+      env.DB.prepare(
+        "UPDATE p2_tasks SET status = 'running', updated_at = ? WHERE id = ? AND status IN ('paused','pausing')",
+      ).bind(Date.now(), task.id),
+      eventStmt(env.DB, task.id, crypto.randomUUID(), "resume", "Dilanjutkan"),
+    ]);
+    return c.json({ status: "running" });
+  } catch (e) {
+    return c.json({ error: `Gagal resume: ${e instanceof Error ? e.message : String(e)}` }, 409);
+  }
+});
+
+// ---- Retry (instance Workflow baru, percobaan ke-N) ----
+taskRoutes.post("/:id/retry", async (c) => {
+  const env = c.env;
+  const task = await getTask(env, c.req.param("id"));
+  if (!task) return c.json({ error: "Tugas tidak ditemukan." }, 404);
+  if (task.status !== "failed") return c.json({ error: "Hanya tugas gagal yang bisa di-retry." }, 409);
+  if (task.attempts >= MAX_ATTEMPTS) {
+    return c.json({ error: `Batas ${MAX_ATTEMPTS} percobaan tercapai.` }, 409);
+  }
+
+  const attempt = task.attempts + 1;
+  const batch = await env.DB.batch([
+    env.DB.prepare(
+      "UPDATE p2_tasks SET status = 'queued', attempts = ?, error = NULL, updated_at = ? WHERE id = ? AND status = 'failed'",
+    ).bind(attempt, Date.now(), task.id),
+    eventStmt(env.DB, task.id, `${task.id}-${attempt}-retry`, "retry", `Retry: percobaan ${attempt}`),
+  ]);
+  if (!batch[0]?.meta.changes) return c.json({ error: "Tugas sudah diproses ulang." }, 409);
+
+  try {
+    const instanceId = await startInstance(env, task.id, attempt);
+    await env.DB.prepare("UPDATE p2_tasks SET instance_id = ? WHERE id = ?").bind(instanceId, task.id).run();
+  } catch (e) {
+    const msg = `Gagal memulai Workflow: ${e instanceof Error ? e.message : String(e)}`;
+    await failTask(env, task.id, `${task.id}-${attempt}-fail`, msg);
+    return c.json({ error: msg }, 502);
+  }
+  return c.json({ status: "queued", attempt });
+});
diff --git a/apps/api/src/phase2/shared.ts b/apps/api/src/phase2/shared.ts
new file mode 100644
index 0000000..8876249
--- /dev/null
+++ b/apps/api/src/phase2/shared.ts
@@ -0,0 +1,38 @@
+// Tipe + helper bersama untuk Fase 2.
+// Binding D1 harus bernama DB. Kalau di wrangler.jsonc namanya lain, ganti di sini.
+
+export interface TaskParams {
+  taskId: string;
+  attempt: number;
+}
+
+export interface Phase2Env {
+  DB: D1Database;
+  TASK_WORKFLOW: Workflow<TaskParams>;
+  GROQ_API_KEY: string;
+  GROQ_MODEL?: string;
+  MAX_TASKS_PER_DAY?: string;
+}
+
+export type TaskStatus =
+  | "queued"
+  | "running"
+  | "pausing"
+  | "paused"
+  | "completed"
+  | "failed";
+
+// Event idempoten: id deterministik, aman kalau step Workflow di-retry.
+export function eventStmt(
+  db: D1Database,
+  taskId: string,
+  id: string,
+  type: string,
+  message: string,
+): D1PreparedStatement {
+  return db
+    .prepare(
+      "INSERT OR REPLACE INTO p2_task_events (id, task_id, type, message, created_at) VALUES (?, ?, ?, ?, ?)",
+    )
+    .bind(id, taskId, type, message, Date.now());
+}
diff --git a/apps/api/src/phase2/workflow.ts b/apps/api/src/phase2/workflow.ts
new file mode 100644
index 0000000..7261883
--- /dev/null
+++ b/apps/api/src/phase2/workflow.ts
@@ -0,0 +1,105 @@
+// Cloudflare Workflow: AI Manager mengerjakan satu tugas.
+// Urutan: load-task -> call-ai -> save-result. Gagal -> mark-failed.
+// Semua status/hasil/token ditulis ke D1, jadi tetap ada setelah browser ditutup.
+
+import { WorkflowEntrypoint, type WorkflowEvent, type WorkflowStep } from "cloudflare:workers";
+import { NonRetryableError } from "cloudflare:workflows";
+import { AiError, createProvider } from "./ai";
+import { eventStmt, type Phase2Env, type TaskParams } from "./shared";
+
+const MANAGER_SYSTEM = `Kamu AI Manager di "AI Virtual Office", kantor virtual berisi agent: Business Analyst, Software Architect, UI/UX Designer, Frontend Dev, Backend Dev, QA Engineer, DevOps & Security Engineer.
+Pemilik mengirim tugas. Balas dalam Bahasa Indonesia, ringkas, dengan bagian:
+1. Pemahaman tugas
+2. Rencana langkah
+3. Pembagian ke agent (hanya yang relevan)
+4. Risiko / hal yang perlu ditanyakan
+5. Hasil atau jawaban langsung bila tugas bisa dijawab sekarang
+Aturan: kamu hanya menghasilkan teks. Jangan mengaku sudah menjalankan kode, deploy, atau mengubah file. Jangan mengarang data.`;
+
+export class ManagerTaskWorkflow extends WorkflowEntrypoint<Phase2Env, TaskParams> {
+  async run(event: WorkflowEvent<TaskParams>, step: WorkflowStep) {
+    const { taskId, attempt } = event.payload;
+    const env = this.env;
+    const key = `${taskId}-${attempt}`;
+
+    try {
+      const task = await step.do("load-task", async () => {
+        const row = await env.DB.prepare("SELECT prompt FROM p2_tasks WHERE id = ?")
+          .bind(taskId)
+          .first<{ prompt: string }>();
+        if (!row) throw new NonRetryableError("Tugas tidak ditemukan di D1");
+        await env.DB.batch([
+          env.DB.prepare(
+            "UPDATE p2_tasks SET status = 'running', error = NULL, updated_at = ? WHERE id = ?",
+          ).bind(Date.now(), taskId),
+          eventStmt(env.DB, taskId, `${key}-start`, "running", `Percobaan ${attempt} dimulai`),
+        ]);
+        return { prompt: row.prompt };
+      });
+
+      const ai = await step.do(
+        "call-ai",
+        {
+          retries: { limit: 3, delay: "10 seconds", backoff: "exponential" },
+          timeout: "60 seconds",
+        },
+        async () => {
+          try {
+            return await createProvider(env).complete([
+              { role: "system", content: MANAGER_SYSTEM },
+              { role: "user", content: task.prompt },
+            ]);
+          } catch (e) {
+            if (e instanceof AiError && !e.retryable) throw new NonRetryableError(e.message);
+            throw e;
+          }
+        },
+      );
+
+      await step.do("save-result", async () => {
+        const now = Date.now();
+        await env.DB.batch([
+          env.DB.prepare(
+            `INSERT OR REPLACE INTO p2_usage_logs
+             (id, task_id, attempt, provider, model, prompt_tokens, completion_tokens, total_tokens, latency_ms, created_at)
+             VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,
+          ).bind(
+            key,
+            taskId,
+            attempt,
+            ai.provider,
+            ai.model,
+            ai.usage.promptTokens,
+            ai.usage.completionTokens,
+            ai.usage.totalTokens,
+            ai.latencyMs,
+            now,
+          ),
+          env.DB.prepare(
+            "UPDATE p2_tasks SET status = 'completed', result = ?, provider = ?, model = ?, error = NULL, updated_at = ? WHERE id = ?",
+          ).bind(ai.text, ai.provider, ai.model, now, taskId),
+          eventStmt(
+            env.DB,
+            taskId,
+            `${key}-done`,
+            "completed",
+            `Selesai oleh ${ai.provider}/${ai.model} dalam ${ai.latencyMs} ms`,
+          ),
+        ]);
+      });
+
+      return { taskId, status: "completed" };
+    } catch (err) {
+      const msg = (err instanceof Error ? err.message : String(err)).slice(0, 500);
+      await step.do("mark-failed", async () => {
+        await env.DB.batch([
+          env.DB.prepare(
+            "UPDATE p2_tasks SET status = 'failed', error = ?, updated_at = ? WHERE id = ?",
+          ).bind(msg, Date.now(), taskId),
+          eventStmt(env.DB, taskId, `${key}-fail`, "failed", msg),
+        ]);
+      });
+      throw err;
+    }
+  }
+}
